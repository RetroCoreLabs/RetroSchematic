<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- the pixel count reads the captured frame through a pointer -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
    <!-- real Avalonia windows without a display, as in RetroCommander's window tests -->
    <PackageReference Include="Avalonia.Headless.NUnit" Version="11.3.6" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\RetroSchematic.Desktop\RetroSchematic.Desktop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\sheets\**\*.json" Link="sheets\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
