  "functions": [
    {
      "output": "9",
      "formula": "Y = STROBE OR ((A1 XNOR B1) AND (A2 XNOR B2) AND (A3 XNOR B3) AND (A4 XNOR B4) AND (A5 XNOR B5) AND (A6 XNOR B6))",
      "text": "Y is high (output transistor off) when the two 6-bit words are equal, or when STROBE is high. Y is low when STROBE is low and the words differ. Open collector, so several can be wired together."
    }
  ],
