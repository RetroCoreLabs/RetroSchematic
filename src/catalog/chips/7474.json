    "bits": 2,
    "changesOn": "rising edge of nCK, each flip-flop on its own clock",
    "rules": [
      "PR low, CLR high: Q = 1, Q' = 0 at once",
      "PR high, CLR low: Q = 0, Q' = 1 at once",
