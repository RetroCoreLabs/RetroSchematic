  "functions": [
    {
      "output": "7",
      "formula": "Y1 = (B'A' AND 1C0) OR (B'A AND 1C1) OR (BA' AND 1C2) OR (BA AND 1C3) when G1'; Z when G1 high",
      "text": "Y1 gives the 1C input picked by B,A (true data) while G1 is low; floats while G1 is high."
    },
    {
      "output": "9",
      "formula": "Y2 = (B'A' AND 2C0) OR (B'A AND 2C1) OR (BA' AND 2C2) OR (BA AND 2C3) when G2'; Z when G2 high",
      "text": "Same for section 2 with G2."
    }
