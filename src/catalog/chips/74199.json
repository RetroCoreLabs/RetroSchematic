      "output": "4,6,8,10,15,17,19,21",
      "formula": "QA..QH = Q[0..7]",
      "text": "Register bits."
    }
  ],
  "state": {
    "bits": 8,
    "changesOn": "rising edge of CLOCK while CLOCK INHIBIT is low (the two inputs are gated together)",
    "rules": [
      "CLEAR' low: QA..QH = L at once",
      "CLOCK INHIBIT high: hold",
      "SHIFT/LOAD' low: QA..QH = A..H at the clock edge",
      "SHIFT/LOAD' high: shift, QB..QH = QAn..QGn, and QA from J,K':",
      "  J=L, K'=H: QA = QAn (no change)",
      "  J=L, K'=L: QA = L",
      "  J=H, K'=H: QA = H",
      "  J=H, K'=L: QA = NOT QAn (toggle)"
    ]
  },
