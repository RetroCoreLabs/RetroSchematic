  "functions": [
    {
      "output": "11,5",
      "formula": "OUT_x1 = IN_x1 XOR (MODE1 OR MODE2) when x_DIS1' AND x_DIS2'; Z otherwise",
      "text": "Channel 1 of each pair passes its input straight through when both mode inputs are 0 and inverts it when either is 1 (differential mode). Floats when either disable input of its side is 1."
    },
    {
      "output": "13,3",
      "formula": "OUT_x2 = IN_x2 when x_DIS1' AND x_DIS2'; Z otherwise",
      "text": "Channel 2 always passes its input non-inverted; floats when either disable input of its side is 1. Tie IN_x1 to IN_x2 for a differential pair."
    }
