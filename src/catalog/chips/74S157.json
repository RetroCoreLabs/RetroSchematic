  "functions": [
    {
      "output": "4",
      "formula": "1Y = STROBE' AND ((SELECT' AND 1A) OR (SELECT AND 1B))",
      "text": "1Y follows 1A when SELECT is low and 1B when SELECT is high; STROBE high forces it low."
    },
    {
