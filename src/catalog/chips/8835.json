  "functions": [
    {
      "output": "1,4,12,15",
      "formula": "BUSx = INx' when DRIVER_DISABLE'; Z when DRIVER_DISABLE high",
      "text": "The driver puts the inverse of INx on the bus while DRIVER DISABLE is low; floats while it is high."
    },
    {
      "output": "3,6,10,13",
      "formula": "OUTx = BUSx' when RECEIVER_DISABLE'; Z when RECEIVER_DISABLE high",
      "text": "The receiver shows the inverse of the bus level while RECEIVER DISABLE is low; floats while it is high. Receiver thresholds (DS88xx): high 1.5..2.0 V, low 0.8..1.5 V, typ 1.75 / 1.35 V (hysteresis)."
    }
  ],
