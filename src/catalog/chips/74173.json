  "functions": [
    {
      "output": "3",
      "formula": "1Q = (M' AND N') ? FF1 : Z",
      "text": "Shows flip-flop 1 when M and N are both low; high impedance when either is high."
    },
    {
      "output": "4",
      "formula": "2Q = (M' AND N') ? FF2 : Z",
      "text": "Shows flip-flop 2 when M and N are both low; high impedance when either is high."
    },
    {
      "output": "5",
      "formula": "3Q = (M' AND N') ? FF3 : Z",
      "text": "Shows flip-flop 3 when M and N are both low; high impedance when either is high."
    },
    {
      "output": "6",
      "formula": "4Q = (M' AND N') ? FF4 : Z",
      "text": "Shows flip-flop 4 when M and N are both low; high impedance when either is high."
    }
  ],
  "state": {
    "bits": 4,
    "changesOn": "rising edge of CLOCK",
    "rules": [
      "CLEAR high: all four flip-flops = 0 at once",
      "CLEAR low, CLOCK low (no edge): hold",
      "CLEAR low, rising CLOCK, G1 high or G2 high: hold",
      "CLEAR low, rising CLOCK, G1 low and G2 low: flip-flop = D",
      "The output controls M and N do not affect the flip-flops"
    ]
  },
