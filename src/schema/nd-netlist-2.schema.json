{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retrocorelabs.github.io/RetroSchematic/schema/nd-netlist-2.schema.json",
  "title": "ND card sheet netlist, format version 2",
  "type": "object",
  "required": [
    "format",
    "formatVersion",
    "sheet",
    "parts",
    "nets"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "nd-netlist"
    },
    "formatVersion": {
      "const": 2
    },
    "sheet": {
      "type": "object",
      "required": [
        "id",
        "title",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "machine": {
          "type": "string"
        },
        "bus": {
          "description": "Which machine bus the card is for; picks the bus-signal and connector catalogues. Missing means unknown (shown as a warning).",
          "enum": [
            "nord-10",
            "nd-100",
            "unknown"
          ]
        },
        "company": {
          "type": "string"
        },
        "drawn": {
          "type": "string"
        },
        "updated": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "required": [
            "document"
          ],
          "additionalProperties": false,
          "properties": {
            "document": {
              "type": "string"
            },
            "pdfPage": {
              "type": "integer",
              "minimum": 1
            },
            "image": {
              "type": "string"
            }
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "parts": {
      "$ref": "#/$defs/parts"
    },
    "gates": {
      "$ref": "#/$defs/gates"
    },
    "nets": {
      "$ref": "#/$defs/nets"
    },
    "layout": {
      "$ref": "#/$defs/layout"
    },
    "blocks": {
      "type": "array",
      "description": "Block definitions (Verilog modules).",
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "instances": {
      "type": "array",
      "description": "Instances of blocks on the top level.",
      "items": {
        "$ref": "#/$defs/instance"
      }
    },
    "display": {
      "$ref": "#/$defs/display"
    },
    "connectors": {
      "type": "array",
      "description": "Which catalogue entry (a file id in catalog/connectors, for the sheet's bus) describes each of the card's connectors. Optional; a connector without an entry is still drawn.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "description": "The connector as pin references name it: P or F (connector not known yet), or P.A, F.B ... with the connector letter.",
            "pattern": "^[PF](\\.[A-Za-z0-9]+)?$"
          },
          "catalog": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "position": {
            "$ref": "#/$defs/point",
            "description": "Top-left corner of the connector box in millimetres, when it was put there by hand. Missing: placed where its wires are shortest."
          },
          "pinSide": {
            "enum": [
              "left",
              "right"
            ],
            "description": "Which side of the box the pins are on. Missing: the side facing the chips."
          },
          "use": {
            "type": "string",
            "description": "What this connector carries on this card, or \"not used\"."
          },
          "used": {
            "type": "boolean",
            "description": "False when the card uses no pin of it."
          },
          "standard": {
            "type": "string",
            "description": "Such as DIN 41612."
          },
          "pins": {
            "type": "string",
            "description": "The pin numbers in words, such as 0-99."
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Row letters of a plug with rows (a, b, c)."
          },
          "pinsPerRow": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "board": {
      "type": "object",
      "additionalProperties": false,
      "description": "What the printed circuit board is. Field names are the ND PCB catalogue's own (pcb.json). Every value optional; missing = not known.",
      "properties": {
        "number": {
          "type": "string",
          "description": "The card number, such as 1050."
        },
        "partNumber": {
          "type": "string",
          "description": "The part number printed on the board, such as 322049."
        },
        "title": {
          "type": "string"
        },
        "ndSystem": {
          "enum": [
            "NORD-10",
            "ND-100"
          ],
          "description": "The ND machine the card plugs into."
        },
        "group": {
          "type": "string",
          "description": "The catalogue's group code, such as 1C."
        },
        "description": {
          "type": "string"
        },
        "printVersion": {
          "type": "string",
          "description": "The print (PCB) version, such as I."
        },
        "ecoVersion": {
          "type": "string",
          "description": "The ECO (engineering change) version."
        },
        "printVersions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "print"
            ],
            "properties": {
              "print": {
                "type": "string"
              },
              "eco": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "specifications": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "widthMm",
                "heightMm"
              ],
              "properties": {
                "widthMm": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "heightMm": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            },
            "layers": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "releaseDate": {
          "type": "string",
          "description": "As the catalogue writes it, such as 01. Jan. 1981."
        },
        "leds": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "color": {
                "type": "string"
              },
              "text": {
                "type": "string",
                "description": "The catalogue's text, as it is."
              }
            }
          }
        },
        "straps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "color": {
                "type": "string"
              },
              "text": {
                "type": "string",
                "description": "The catalogue's text, as it is."
              }
            }
          }
        },
        "switches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "color": {
                "type": "string"
              },
              "text": {
                "type": "string",
                "description": "The catalogue's text, as it is."
              }
            }
          },
          "description": "The catalogue's switch text; the sheet's own switches list holds the worked-out blocks."
        },
        "connectors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "color": {
                "type": "string"
              },
              "text": {
                "type": "string",
                "description": "The catalogue's text, as it is."
              }
            }
          },
          "description": "The catalogue's connector text."
        },
        "chipset": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            }
          }
        },
        "sourceUrl": {
          "type": "string",
          "description": "The web page the catalogue entry was scraped from."
        },
        "factSources": {
          "type": "object",
          "description": "Field name -> where that fact came from.",
          "additionalProperties": {
            "$ref": "#/$defs/boardSource"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "sources": {
      "type": "array",
      "description": "The original schematic pages. file is relative to the sheet; in a .rsx it is an entry inside the zip (sources/...).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file"
        ],
        "properties": {
          "file": {
            "type": "string",
            "description": "A picture (PNG, JPEG) or a PDF, relative to the sheet, forward slashes."
          },
          "pdfPage": {
            "type": "integer",
            "minimum": 1,
            "description": "For a PDF: the page, 1 = first."
          },
          "title": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "original": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file"
            ],
            "description": "The PDF and page a stored picture was rendered from.",
            "properties": {
              "file": {
                "type": "string"
              },
              "pdfPage": {
                "type": "integer",
                "minimum": 1
              },
              "dpi": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "photos": {
      "type": "array",
      "description": "Photos of the board. file is relative to the sheet; in a .rsx it is an entry inside the zip (photos/...).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "side"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "side": {
            "enum": [
              "component",
              "solder"
            ]
          },
          "version": {
            "type": "string"
          },
          "variant": {
            "type": "string",
            "description": "Which board the photo shows when there are several, such as old or new."
          },
          "caption": {
            "type": "string"
          },
          "source": {
            "$ref": "#/$defs/boardSource"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "switches": {
      "type": "array",
      "description": "The switch blocks on the card and what each lever sets.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "leverCount",
          "levers"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "description": "The board position, such as 15E."
          },
          "function": {
            "type": "string"
          },
          "leverCount": {
            "type": "integer",
            "minimum": 1
          },
          "onMeans": {
            "enum": [
              "0",
              "1",
              "open"
            ],
            "description": "The bit value a lever that is on (closed) gives."
          },
          "onMeansConfidence": {
            "$ref": "#/$defs/confidence"
          },
          "typical": {
            "type": "string"
          },
          "levers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "number",
                "confidence"
              ],
              "properties": {
                "number": {
                  "type": "integer",
                  "minimum": 1
                },
                "signal": {
                  "type": "string"
                },
                "bit": {
                  "type": "string"
                },
                "confidence": {
                  "$ref": "#/$defs/confidence"
                },
                "setting": {
                  "enum": [
                    "on",
                    "off",
                    "open"
                  ]
                },
                "note": {
                  "type": "string"
                }
              }
            }
          },
          "source": {
            "$ref": "#/$defs/boardSource"
          },
          "moreSources": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/boardSource"
            },
            "description": "Further sources, such as the ND PCB catalogue's switch text (quote)."
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "confidence": {
      "enum": [
        "read",
        "inferred",
        "open"
      ]
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref",
          "type",
          "confidence"
        ],
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "function": {
            "type": "string"
          },
          "confidence": {
            "$ref": "#/$defs/confidence"
          },
          "note": {
            "type": "string"
          },
          "position": {
            "$ref": "#/$defs/point"
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "part",
          "kind",
          "inputs",
          "output",
          "confidence"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "part": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "nand",
              "nor",
              "not",
              "and",
              "or",
              "buffer",
              "and-or-invert",
              "other"
            ]
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "output": {
            "type": "integer",
            "minimum": 1
          },
          "position": {
            "type": "object",
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            }
          },
          "confidence": {
            "$ref": "#/$defs/confidence"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "nets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "active",
          "pins"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "active": {
            "enum": [
              "high",
              "low",
              "none"
            ]
          },
          "pins": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "at",
                "confidence"
              ],
              "additionalProperties": false,
              "properties": {
                "at": {
                  "type": "string",
                  "pattern": "^.+\\.[0-9]+$"
                },
                "confidence": {
                  "$ref": "#/$defs/confidence"
                },
                "note": {
                  "type": "string"
                }
              }
            }
          },
          "note": {
            "type": "string"
          },
          "drive": {
            "enum": [
              "totem-pole",
              "open-collector",
              "open-collector-high-voltage",
              "three-state",
              "none"
            ],
            "description": "What kind of output drives the line: normal TTL (totem-pole), open collector (several outputs may share the line, it needs a pull-up and reads as the AND of them), three-state bus, or none (supply, input-only from outside the sheet). Absent = not read yet. open-collector-high-voltage: open collector rated for a higher pull-up voltage than 5 V (7406, 7407, 7416, 7417: up to 30 or 15 V), used to drive lamps, relays or lines."
          },
          "pullUp": {
            "type": "string",
            "description": "For an open-collector line: the pull-up resistor as written on the drawing (e.g. '1k to +5V'), or 'open' if not read."
          },
          "driveConfidence": {
            "$ref": "#/$defs/confidence"
          },
          "description": {
            "type": "string",
            "description": "What the signal does, in plain words. Only what a source says; never made up. Optional (added within version 1)."
          },
          "descriptionSource": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "confidence"
            ],
            "description": "Where the description came from and how sure it is.",
            "properties": {
              "kind": {
                "enum": [
                  "drawing",
                  "manual",
                  "reading",
                  "inferred",
                  "catalogue"
                ]
              },
              "document": {
                "type": "string",
                "description": "The document, such as docs/2A50-reading.md or a manual number."
              },
              "place": {
                "type": "string",
                "description": "Where in it: a section heading or a page."
              },
              "confidence": {
                "$ref": "#/$defs/confidence"
              },
              "quote": {
                "type": "string",
                "description": "The source's own words, as they are."
              },
              "note": {
                "type": "string"
              }
            }
          },
          "function": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Short tags for what the signal is for, such as interrupt, status, clock."
          }
        }
      }
    },
    "layout": {
      "type": "object",
      "description": "Drawing only, never connections: wire paths fixed by hand. Optional (added within version 1).",
      "additionalProperties": false,
      "properties": {
        "wires": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "net",
              "branches"
            ],
            "additionalProperties": false,
            "properties": {
              "net": {
                "type": "string",
                "description": "The signal's name."
              },
              "active": {
                "enum": [
                  "high",
                  "low",
                  "none"
                ],
                "description": "The signal's active level; tells apart two signals of the same name."
              },
              "branches": {
                "type": "array",
                "description": "The first branch joins two pins; each later one runs from a pin to the wire before it. Points in whole mm from the top left; every piece level or upright.",
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "$ref": "#/$defs/point"
                  }
                }
              }
            }
          }
        },
        "buses": {
          "type": "array",
          "description": "Virtual buses (drawing only, never connections). Optional (added within version 1).",
          "items": {
            "type": "object",
            "required": [
              "name",
              "path",
              "members"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "description": "The bus name."
              },
              "path": {
                "type": "array",
                "description": "Bend points in whole mm; every piece level or upright. Empty: not drawn yet.",
                "items": {
                  "$ref": "#/$defs/point"
                }
              },
              "members": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "net"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "net": {
                      "type": "string"
                    },
                    "active": {
                      "enum": [
                        "high",
                        "low",
                        "none"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "signalRef": {
      "type": "object",
      "required": [
        "net"
      ],
      "additionalProperties": false,
      "properties": {
        "net": {
          "type": "string",
          "description": "A signal's name on this level."
        },
        "active": {
          "enum": [
            "high",
            "low",
            "none"
          ],
          "description": "Its level; tells apart two signals of the same name."
        }
      }
    },
    "port": {
      "type": "object",
      "required": [
        "name",
        "direction",
        "signals"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "direction": {
          "enum": [
            "input",
            "output",
            "inout"
          ],
          "description": "Seen from inside the block."
        },
        "signals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/signalRef"
          },
          "description": "The signals inside the block; one = single port, more = bus port, entry 0 the lowest bit."
        },
        "side": {
          "enum": [
            "left",
            "right",
            "top",
            "bottom"
          ],
          "description": "Drawing only."
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "description": "Drawing only: place along the side."
        }
      }
    },
    "instance": {
      "type": "object",
      "required": [
        "name",
        "block"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "block": {
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/point"
        },
        "connections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "port",
              "nets"
            ],
            "additionalProperties": false,
            "properties": {
              "port": {
                "type": "string"
              },
              "nets": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/signalRef"
                }
              }
            }
          }
        }
      }
    },
    "block": {
      "type": "object",
      "required": [
        "name",
        "ports",
        "parts",
        "nets"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "parts": {
          "$ref": "#/$defs/parts"
        },
        "gates": {
          "$ref": "#/$defs/gates"
        },
        "nets": {
          "$ref": "#/$defs/nets"
        },
        "layout": {
          "$ref": "#/$defs/layout"
        },
        "instances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/instance"
          }
        }
      }
    },
    "display": {
      "type": "object",
      "description": "How this sheet likes to be shown: each value overrides the viewer's default for this sheet. A missing value means use the default. Display only, never connections. Optional.",
      "additionalProperties": false,
      "properties": {
        "nameStyle": {
          "enum": [
            "slash",
            "tilde",
            "subscript"
          ],
          "description": "Active-low names as /NAME, ~NAME, or NAME with ND's subscript 0/1."
        },
        "symbols": {
          "enum": [
            "nd",
            "modern"
          ],
          "description": "ND 1976 symbols or modern ones."
        },
        "theme": {
          "type": "string",
          "description": "Colour theme by name, such as Light or Dark."
        },
        "pinNumbers": {
          "type": "boolean"
        },
        "boardPositions": {
          "type": "boolean"
        },
        "portArrows": {
          "type": "boolean"
        },
        "buses": {
          "type": "boolean",
          "description": "Draw the buses; false draws every member on its own."
        },
        "tracePulse": {
          "type": "boolean",
          "description": "A traced signal pulses; false shows it still."
        },
        "lineWidth": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 3,
          "description": "How thick every line is drawn, as a factor of the normal widths (1 = normal)."
        }
      }
    },
    "boardSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "confidence"
      ],
      "description": "Where the facts come from.",
      "properties": {
        "kind": {
          "enum": [
            "drawing",
            "manual",
            "reading",
            "inferred",
            "catalogue"
          ]
        },
        "document": {
          "type": "string"
        },
        "place": {
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "quote": {
          "type": "string",
          "description": "The source's own words, as they are."
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
