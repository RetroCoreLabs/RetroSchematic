<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>RetroSchematic</AssemblyName>
    <RootNamespace>RetroSchematic.Desktop</RootNamespace>
    <OutputType>WinExe</OutputType>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- the program's icon in Explorer; the .rsc/.rsx file association shows it too (DefaultIcon = the exe) -->
    <ApplicationIcon>..\assets\RetroSchematic.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- the same icon for the windows' title bars -->
    <AvaloniaResource Include="..\assets\RetroSchematic.ico" Link="Assets\RetroSchematic.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- the same Avalonia version as RetroCommander, so the two programs move together -->
    <PackageReference Include="Avalonia" Version="11.3.6" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.6" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.6" />
    <!-- Avalonia 11.3.6 pulls Tmds.DBus.Protocol 0.21.2, which has a high-severity advisory
         (GHSA-xrw6-gwf8-vvr9). 0.21.3 is the fix on the same line; referencing it directly makes
         NuGet take it (RetroCommander pins it the same way). -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RetroSchematic.Model\RetroSchematic.Model.csproj" />
    <ProjectReference Include="..\RetroSchematic.Render\RetroSchematic.Render.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- File > Open the demo sheet finds this copy next to the program; the chip files let a
         copy of the program outside the repository place chips and list their pins -->
    <None Include="..\sheets\demo\demo-gates.rsc" Link="sheets\demo\demo-gates.rsc" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\catalog\chips\*.json" Link="catalog\chips\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\catalog\signals\*.json" Link="catalog\signals\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\catalog\connectors\*.json" Link="catalog\connectors\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\catalog\boards\*.json" Link="catalog\boards\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RetroSchematic.Desktop.Tests" />
  </ItemGroup>
</Project>
