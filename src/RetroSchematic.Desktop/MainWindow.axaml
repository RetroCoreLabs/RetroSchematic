<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:RetroSchematic.Desktop.Controls"
        x:Class="RetroSchematic.Desktop.MainWindow"
        Title="RetroSchematic"
        Icon="avares://RetroSchematic/Assets/RetroSchematic.ico"
        Width="1400" Height="900"
        Background="{DynamicResource FluentBackgroundPrimaryBrush}">
  <!-- Layout and colours follow RetroCommander: every colour is a {DynamicResource} brush from
       Themes/ThemeManager.cs, so View > Theme re-colours the window live. -->
  <DockPanel>
    <Menu DockPanel.Dock="Top" Background="{DynamicResource FluentSurfaceAltBrush}">
      <MenuItem Header="_File">
        <MenuItem Header="_New sheet">
          <MenuItem Header="NORD-10 card" Tag="nord-10" Click="OnNewForBus"/>
          <MenuItem Header="ND-100 card" Tag="nd-100" Click="OnNewForBus"/>
          <MenuItem Header="Bus not known yet" Click="OnNew" HotKey="Ctrl+N" InputGesture="Ctrl+N"/>
        </MenuItem>
        <MenuItem Header="_Open sheet..." Click="OnOpen" HotKey="Ctrl+O" InputGesture="Ctrl+O"/>
        <MenuItem Header="_Recent sheets" x:Name="RecentItem"/>
        <MenuItem Header="Card _library..." Click="OnCardLibrary" x:Name="CardLibraryItem"
                  ToolTip.Tip="Every card in the library, by machine family (NORD-10, ND-100, ...), read from the sheet files"/>
        <MenuItem Header="Open the _demo sheet" Click="OnOpenDemo" x:Name="OpenDemoItem"/>
        <Separator/>
        <MenuItem Header="_Save sheet" Click="OnSave" x:Name="SaveItem" IsEnabled="False" HotKey="Ctrl+S" InputGesture="Ctrl+S"/>
        <MenuItem Header="Save sheet _as..." Click="OnSaveAs" x:Name="SaveAsItem" IsEnabled="False"/>
        <MenuItem Header="Convert to a card with _pages" Click="OnConvertToPages" x:Name="ConvertPagesItem" IsEnabled="False"
                  ToolTip.Tip="Format version 3: one file holds every schematic page of the card. The sheet becomes page 1; nothing that is connected changes"/>
        <MenuItem Header="Add a pa_ge..." Click="OnAddPage" x:Name="AddPageItem" IsEnabled="False"
                  ToolTip.Tip="A new, empty page at the end; chips placed while it is shown go on it"/>
        <MenuItem Header="Put the picked part on page..." Click="OnPartToPage" x:Name="PartToPageItem" IsEnabled="False"/>
        <MenuItem Header="B_us use, all cards..." Click="OnBusUse" x:Name="BusUseItem"
                  ToolTip.Tip="Every backplane signal of every card (ND-100 plugs, NORD-10 edge fingers), and the chips that drive and read it; saves a Markdown report"/>
        <MenuItem Header="_Board info..." Click="OnBoardInfo" x:Name="BoardInfoItem" IsEnabled="False"
                  ToolTip.Tip="The board: machine, card and part numbers, versions, size, connectors, original pages and photos"/>
        <MenuItem Header="_Import board info from the ND PCB catalogue..." Click="OnImportCatalogue" x:Name="ImportCatalogueItem" IsEnabled="False"
                  ToolTip.Tip="Pick pcb.json (the ND PCB catalogue): fills the board facts, copies the board photos and adds the catalogue's switch text; the board is found by its part or card number"/>
        <MenuItem Header="Save as S_VG..." Click="OnSaveSvg" x:Name="SaveSvgItem" IsEnabled="False"/>
        <MenuItem Header="Export _PNG..." Click="OnExportPng" x:Name="ExportPngItem" IsEnabled="False"/>
        <Separator/>
        <!-- per-user Windows file association (HKEY_CURRENT_USER only, no administrator rights) -->
        <MenuItem Header="Open .rsc/.rsx files with RetroSchematic" Click="OnAssociate" x:Name="AssociateItem"/>
        <MenuItem Header="Stop opening .rsc/.rsx files with RetroSchematic" Click="OnUnassociate" x:Name="UnassociateItem"/>
        <Separator/>
        <MenuItem Header="E_xit" Click="OnExit"/>
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Edit mode (off = read-only)" x:Name="EditModeItem" Click="OnToggleEditMode" ToggleType="CheckBox"
                  IsEnabled="False" HotKey="Ctrl+E" InputGesture="Ctrl+E"/>
        <Separator/>
        <MenuItem Header="_Undo" Click="OnUndo" x:Name="UndoItem" IsEnabled="False" HotKey="Ctrl+Z" InputGesture="Ctrl+Z"/>
        <MenuItem Header="_Redo" Click="OnRedo" x:Name="RedoItem" IsEnabled="False" HotKey="Ctrl+Y" InputGesture="Ctrl+Y"/>
        <MenuItem Header="_Delete picked item" Click="OnDelete" x:Name="DeleteItem" IsEnabled="False" InputGesture="Delete"/>
        <Separator/>
        <MenuItem Header="_Fix the picked signal's wire path" Click="OnFixWire" x:Name="FixWireItem" IsEnabled="False"
                  ToolTip.Tip="Keep this wire exactly where it is now; it is saved with the sheet"/>
        <MenuItem Header="Route the picked signal _automatically again" Click="OnFreeWire" x:Name="FreeWireItem" IsEnabled="False"/>
        <Separator/>
        <MenuItem Header="New _bus..." Click="OnNewBus" x:Name="NewBusItem" IsEnabled="False"
                  ToolTip.Tip="Name a bus, tick its signals, then click out its path (drawing only)"/>
        <Separator/>
        <MenuItem Header="Make bloc_k from the picked parts..." Click="OnMakeBlock" x:Name="MakeBlockItem" IsEnabled="False"
                  ToolTip.Tip="Ctrl-click or drag a box round chips, then make them one block; connections never change"/>
        <MenuItem Header="_Up one level" Click="OnUpLevel" x:Name="UpLevelItem" IsEnabled="False"/>
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Back" x:Name="BackItem" Click="OnBack" IsEnabled="False" HotKey="Alt+Left" InputGesture="Alt+Left"/>
        <MenuItem Header="_Forward" x:Name="ForwardItem" Click="OnForward" IsEnabled="False" HotKey="Alt+Right" InputGesture="Alt+Right"/>
        <Separator/>
        <MenuItem Header="_ND 1976 symbols" x:Name="NdStyleItem" Click="OnNdStyle" ToggleType="Radio"/>
        <MenuItem Header="_Modern symbols" x:Name="ModernStyleItem" Click="OnModernStyle" ToggleType="Radio"/>
        <Separator/>
        <MenuItem Header="Show _pin numbers" x:Name="PinNumbersItem" Click="OnTogglePinNumbers" ToggleType="CheckBox" IsChecked="True"/>
        <MenuItem Header="Show _board positions" x:Name="BoardPositionsItem" Click="OnToggleBoardPositions" ToggleType="CheckBox" IsChecked="True"/>
        <MenuItem Header="Show port _arrows" x:Name="PortArrowsItem" Click="OnTogglePortArrows" ToggleType="CheckBox" IsChecked="True"/>
        <MenuItem Header="Show b_uses" x:Name="ShowBusesItem" Click="OnToggleShowBuses" ToggleType="CheckBox" IsChecked="True"
                  ToolTip.Tip="Off: buses are hidden and every member is drawn on its own. The sheet keeps its buses."/>
        <Separator/>
        <MenuItem Header="_Settings..." x:Name="SettingsItem" Click="OnSettings" HotKey="Ctrl+OemComma" InputGesture="Ctrl+OemComma"/>
        <Separator/>
        <MenuItem Header="_Fit to window" Click="OnFit" HotKey="Ctrl+D0" InputGesture="Ctrl+0"/>
        <Separator/>
        <MenuItem Header="Card _overview" Tag="overview" Click="OnViewItem" x:Name="OverviewItem" HotKey="F4" InputGesture="F4"
                  ToolTip.Tip="The card's pages with their titles, and the board photos"/>
        <MenuItem Header="_Next page" Click="OnNextPage" x:Name="NextPageItem" IsEnabled="False" InputGesture="PageDown"/>
        <MenuItem Header="Pre_vious page" Click="OnPreviousPage" x:Name="PreviousPageItem" IsEnabled="False" InputGesture="PageUp"/>
        <MenuItem Header="Split crowded pages automatically" x:Name="SplitPagesItem" Click="OnToggleSplitPages" ToggleType="CheckBox" IsEnabled="False"
                  ToolTip.Tip="Off: one drawn page per original page. On: a page with more than 16 chips is drawn as several pages, grouped by shared signals (saved with the card)"/>
        <MenuItem Header="_Drawing" Tag="drawing" Click="OnViewItem" HotKey="F5" InputGesture="F5"/>
        <MenuItem Header="_Original page" Tag="original" Click="OnViewItem" HotKey="F6" InputGesture="F6"/>
        <MenuItem Header="PCB _front (component side)" Tag="front" Click="OnViewItem" HotKey="F7" InputGesture="F7"/>
        <MenuItem Header="PCB b_ack (solder side)" Tag="back" Click="OnViewItem" HotKey="F8" InputGesture="F8"/>
        <MenuItem Header="Chip bo_xes on the photos" x:Name="ChipBoxesItem" Click="OnChipBoxesItem" ToggleType="CheckBox" HotKey="F9" InputGesture="F9"/>
        <MenuItem Header="Board _corners on the photos" x:Name="BoardCornersItem" Click="OnBoardCornersItem" ToggleType="CheckBox"/>
                <MenuItem Header="_Edge fingers on the photos" x:Name="EdgeFingersItem" Click="OnEdgeFingersItem" ToggleType="CheckBox"/>
        <Separator/>
        <MenuItem Header="_Theme" x:Name="ThemeMenu"/>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About RetroSchematic..." x:Name="AboutItem" Click="OnAbout"/>
      </MenuItem>
    </Menu>

    <!-- toolbar: icon buttons for the common commands. The icons are outlines from
         Styles/Icons.axaml in the theme's text colour. Buttons for things not built yet (buses,
         blocks, port arrows, the simulator) are there but switched off, and say so. -->
    <Border DockPanel.Dock="Top" Classes="app-toolbar" Padding="6,2">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <!-- Back / Forward through what was picked, as in a web browser -->
        <Button x:Name="TbBack" Classes="toolbar-button icon" Click="OnBack" IsEnabled="False" ToolTip.Tip="Back (Alt+Left)" ToolTip.ShowOnDisabled="True"><Path Classes="toolbar-icon" Data="{StaticResource IconBack}"/></Button>
        <Button x:Name="TbForward" Classes="toolbar-button icon" Click="OnForward" IsEnabled="False" ToolTip.Tip="Forward (Alt+Right)" ToolTip.ShowOnDisabled="True"><Path Classes="toolbar-icon" Data="{StaticResource IconForward}"/></Button>
        <Border Classes="toolbar-divider"/>
        <Button x:Name="TbNew" Classes="toolbar-button icon" Click="OnNew" ToolTip.Tip="New sheet (Ctrl+N)" ToolTip.ShowOnDisabled="True"><Path Classes="toolbar-icon" Data="{StaticResource IconNew}"/></Button>
        <Button x:Name="TbOpen" Classes="toolbar-button icon" Click="OnOpen" ToolTip.Tip="Open sheet (Ctrl+O)" ToolTip.ShowOnDisabled="True"><Path Classes="toolbar-icon" Data="{StaticResource IconOpen}"/></Button>
        <Button x:Name="TbSave" Classes="toolbar-button icon" Click="OnSave" IsEnabled="False" ToolTip.Tip="Save sheet (Ctrl+S)" ToolTip.ShowOnDisabled="True"><Path Classes="toolbar-icon" Data="{StaticResource IconSave}"/></Button>
        <Button x:Name="TbExportPng" Classes="toolbar-button icon" Click="OnExportPng" IsEnabled="False" ToolTip.Tip="Export PNG" ToolTip.ShowOnDisabled="True"><Path Classes="toolbar-icon" Data="{StaticResource IconExportPng}"/></Button>
        <Button x:Name="TbExportSvg" Classes="toolbar-button icon" Click="OnSaveSvg" IsEnabled="False" ToolTip.Tip="Save as SVG" ToolTip.ShowOnDisabled="True"><Path Classes="toolbar-icon" Data="{StaticResource IconExportSvg}"/></Button>
        <Border Classes="toolbar-divider"/>
        <Button x:Name="TbUndo" Classes="toolbar-button icon" Click="OnUndo" IsEnabled="False" ToolTip.Tip="Undo (Ctrl+Z)" ToolTip.ShowOnDisabled="True"><Path Classes="toolbar-icon" Data="{StaticResource IconUndo}"/></Button>
        <Button x:Name="TbRedo" Classes="toolbar-button icon" Click="OnRedo" IsEnabled="False" ToolTip.Tip="Redo (Ctrl+Y)" ToolTip.ShowOnDisabled="True"><Path Classes="toolbar-icon" Data="{StaticResource IconRedo}"/></Button>
        <Border Classes="toolbar-divider"/>
        <ToggleButton x:Name="TbEditMode" Classes="toolbar-button" Click="OnToggleEditMode" IsEnabled="False" ToolTip.Tip="Edit mode on/off (Ctrl+E). Off = read-only: nothing can be changed." ToolTip.ShowOnDisabled="True"><Path Classes="toolbar-icon" Data="{StaticResource IconEditMode}"/></ToggleButton>
        <Border Classes="toolbar-divider"/>
        <ToggleButton x:Name="TbSelect" Classes="toolbar-button" Click="OnToolSelect" ToolTip.Tip="Select: click to pick, drag a chip to move it (in edit mode)" ToolTip.ShowOnDisabled="True"><Path Classes="toolbar-icon" Data="{StaticResource IconSelect}"/></ToggleButton>
        <ToggleButton x:Name="TbPlace" Classes="toolbar-button" Click="OnToolPlace" IsEnabled="False" ToolTip.Tip="Place chip: pick the type in the box on the right, then click on the sheet (edit mode)" ToolTip.ShowOnDisabled="True"><Path Classes="toolbar-icon" Data="{StaticResource IconPlaceChip}"/></ToggleButton>
        <ToggleButton x:Name="TbWire" Classes="toolbar-button" Click="OnToolWire" IsEnabled="False" ToolTip.Tip="Wire: drag from one pin to another (edit mode)" ToolTip.ShowOnDisabled="True"><Path Classes="toolbar-icon" Data="{StaticResource IconWire}"/></ToggleButton>
        <ToggleButton x:Name="TbBus" Classes="toolbar-button" Click="OnNewBus" IsEnabled="False" ToolTip.Tip="New bus: name it, tick its signals, then click out its path; click the last point again to finish (edit mode). Drawing only - connections never change." ToolTip.ShowOnDisabled="True"><Path Classes="toolbar-icon" Data="{StaticResource IconBus}"/></ToggleButton>
        <ToggleButton x:Name="TbTrace" Classes="toolbar-button" Click="OnToolTrace" IsEnabled="False" ToolTip.Tip="Trace: click a wire, label or pin to show the whole signal; Esc or empty paper clears. Works in read-only mode." ToolTip.ShowOnDisabled="True"><Path Classes="toolbar-icon" Data="{StaticResource IconTrace}"/></ToggleButton>
        <Border Classes="toolbar-divider"/>
        <Button x:Name="TbMakeBlock" Classes="toolbar-button icon" Click="OnMakeBlock" IsEnabled="False" ToolTip.Tip="Make a block from the picked parts: Ctrl-click them or drag a box round them first (edit mode). Connections never change." ToolTip.ShowOnDisabled="True"><Path Classes="toolbar-icon" Data="{StaticResource IconMakeBlock}"/></Button>
        <Button x:Name="TbUpLevel" Classes="toolbar-button icon" Click="OnUpLevel" IsEnabled="False" ToolTip.Tip="Up one level, out of the block shown" ToolTip.ShowOnDisabled="True"><Path Classes="toolbar-icon" Data="{StaticResource IconUpLevel}"/></Button>
        <Border Classes="toolbar-divider"/>
        <Button x:Name="TbZoomIn" Classes="toolbar-button icon" Click="OnZoomIn" IsEnabled="False" ToolTip.Tip="Zoom in" ToolTip.ShowOnDisabled="True"><Path Classes="toolbar-icon" Data="{StaticResource IconZoomIn}"/></Button>
        <Button x:Name="TbZoomOut" Classes="toolbar-button icon" Click="OnZoomOut" IsEnabled="False" ToolTip.Tip="Zoom out" ToolTip.ShowOnDisabled="True"><Path Classes="toolbar-icon" Data="{StaticResource IconZoomOut}"/></Button>
        <Button x:Name="TbFit" Classes="toolbar-button icon" Click="OnFit" IsEnabled="False" ToolTip.Tip="Fit to window (Ctrl+0)" ToolTip.ShowOnDisabled="True"><Path Classes="toolbar-icon" Data="{StaticResource IconZoomFit}"/></Button>
        <Border Classes="toolbar-divider"/>
        <ToggleButton x:Name="TbPinNumbers" Classes="toolbar-button" Click="OnTogglePinNumbers" ToolTip.Tip="Show pin numbers" ToolTip.ShowOnDisabled="True"><Path Classes="toolbar-icon" Data="{StaticResource IconPinNumbers}"/></ToggleButton>
        <ToggleButton x:Name="TbBoardPositions" Classes="toolbar-button" Click="OnToggleBoardPositions" ToolTip.Tip="Show board positions" ToolTip.ShowOnDisabled="True"><Path Classes="toolbar-icon" Data="{StaticResource IconBoardPositions}"/></ToggleButton>
        <ToggleButton x:Name="TbPortArrows" Classes="toolbar-button" Click="OnTogglePortArrows" ToolTip.Tip="Show port direction arrows on blocks" ToolTip.ShowOnDisabled="True"><Path Classes="toolbar-icon" Data="{StaticResource IconPortArrows}"/></ToggleButton>
        <ToggleButton x:Name="TbShowBuses" Classes="toolbar-button" Click="OnToggleShowBuses" ToolTip.Tip="Show buses (off: every member drawn on its own; the sheet keeps its buses)" ToolTip.ShowOnDisabled="True"><Path Classes="toolbar-icon" Data="{StaticResource IconShowBuses}"/></ToggleButton>
        <Button x:Name="TbSettings" Classes="toolbar-button icon" Click="OnSettings" ToolTip.Tip="Settings (Ctrl+,)" ToolTip.ShowOnDisabled="True"><Path Classes="toolbar-icon" Data="{StaticResource IconSettings}"/></Button>
        <Border Classes="toolbar-divider"/>
        <Button x:Name="TbRun" Classes="toolbar-button icon" IsEnabled="False" ToolTip.Tip="Run the simulation (not built yet)" ToolTip.ShowOnDisabled="True"><Path Classes="toolbar-icon" Data="{StaticResource IconRun}"/></Button>
        <Button x:Name="TbPause" Classes="toolbar-button icon" IsEnabled="False" ToolTip.Tip="Pause (not built yet)" ToolTip.ShowOnDisabled="True"><Path Classes="toolbar-icon" Data="{StaticResource IconPause}"/></Button>
        <Button x:Name="TbStep" Classes="toolbar-button icon" IsEnabled="False" ToolTip.Tip="One step (not built yet)" ToolTip.ShowOnDisabled="True"><Path Classes="toolbar-icon" Data="{StaticResource IconStep}"/></Button>
        <Button x:Name="TbReset" Classes="toolbar-button icon" IsEnabled="False" ToolTip.Tip="Reset (not built yet)" ToolTip.ShowOnDisabled="True"><Path Classes="toolbar-icon" Data="{StaticResource IconReset}"/></Button>
        <Border Classes="toolbar-divider"/>
        <!-- what the middle shows: the drawing, the original page, or a photo of either side of the board -->
        <ToggleButton x:Name="TbViewDrawing" Classes="toolbar-button view-switch" Tag="drawing" Click="OnViewButton" Content="Drawing" ToolTip.Tip="The drawing (F5)"/>
        <ToggleButton x:Name="TbViewOriginal" Classes="toolbar-button view-switch" Tag="original" Click="OnViewButton" Content="Original" IsEnabled="False" ToolTip.Tip="The original schematic page the sheet was read from (F6)" ToolTip.ShowOnDisabled="True"/>
        <ToggleButton x:Name="TbViewFront" Classes="toolbar-button view-switch" Tag="front" Click="OnViewButton" Content="PCB front" IsEnabled="False" ToolTip.Tip="Photo of the component side of the board (F7)" ToolTip.ShowOnDisabled="True"/>
        <ToggleButton x:Name="TbViewBack" Classes="toolbar-button view-switch" Tag="back" Click="OnViewButton" Content="PCB back" IsEnabled="False" ToolTip.Tip="Photo of the solder side of the board (F8)" ToolTip.ShowOnDisabled="True"/>
        <!-- the chip grid on the photos: boxes named by position, and the board outline -->
        <ToggleButton x:Name="TbChipBoxes" Classes="toolbar-button view-switch" Click="OnToggleChipBoxes" Content="Chips" IsEnabled="False"
                      ToolTip.Tip="Draw a see-through, named box on every chip of the PCB photos (dashed: the grid cell of its position code; solid: set by hand). In edit mode drag a box to move it, a box corner to size it, Shift and a corner to turn it." ToolTip.ShowOnDisabled="True"/>
        <ToggleButton x:Name="TbBoardCorners" Classes="toolbar-button view-switch" Click="OnToggleBoardCorners" Content="Corners" IsEnabled="False"
                      ToolTip.Tip="Show the board outline the grid is placed on; in edit mode drag a corner to where the board's corner is in the photo (saved per photo)" ToolTip.ShowOnDisabled="True"/>
        <ToggleButton x:Name="TbEdgeFingers" Classes="toolbar-button view-switch" Click="OnToggleEdgeFingers" Content="Fingers" IsEnabled="False"
                      ToolTip.Tip="Edge fingers: label each gold finger of the backplane edge with its pin number and signal (the card's own name where it uses the pin, else the bus catalogue's). Hover for the details, click to pick and trace the signal. In edit mode drag a finger to move the whole row if it is off." ToolTip.ShowOnDisabled="True"/>
        <Border Classes="toolbar-divider"/>
        <ComboBox x:Name="ChipBox" Classes="fluent-combobox" Width="140" IsEnabled="False" SelectionChanged="OnChipPicked"
                  VerticalAlignment="Center" ToolTip.Tip="The chip type the Place chip tool puts down"/>
        <TextBlock x:Name="ModeText" Classes="fluent-text" VerticalAlignment="Center" Margin="10,0,0,0" Text="Read-only"/>
      </StackPanel>
    </Border>


    <Border DockPanel.Dock="Bottom" Classes="status-bar">
      <TextBlock x:Name="StatusText" Text="Open a sheet (File > Open sheet), or File > New sheet."/>
    </Border>

    <Grid ColumnDefinitions="260,4,*,4,320">
      <!-- left: search, and the sheet's parts and signals -->
      <Border Grid.Column="0" Classes="panel-border" Margin="6,6,0,6">
        <DockPanel>
          <!-- the search box: a magnifier, the text, a button that empties it -->
          <Border DockPanel.Dock="Top" Classes="side-search">
            <DockPanel>
              <Path DockPanel.Dock="Left" Classes="side-search-icon" Data="{StaticResource IconSearch}"/>
              <Button x:Name="SearchClear" DockPanel.Dock="Right" Classes="side-clear" IsVisible="False"
                      ToolTip.Tip="Clear the search" Click="OnSearchClear">
                <Path Data="{StaticResource IconClear}"/>
              </Button>
              <TextBox x:Name="SearchBox" Classes="side-search-text"
                       Watermark="Search part, signal or pin (11D.3)" TextChanged="OnSearchChanged"/>
            </DockPanel>
          </Border>
          <TabControl x:Name="ListTabs" Classes="side-tabs">
            <TabItem Header="Parts">
              <ListBox x:Name="PartsList" Classes="side-list" SelectionChanged="OnPartPicked"/>
            </TabItem>
            <TabItem Header="Signals">
              <ListBox x:Name="NetsList" Classes="side-list" SelectionChanged="OnNetPicked"/>
            </TabItem>
            <TabItem Header="Found" x:Name="FoundTab">
              <ListBox x:Name="FoundList" Classes="side-list" SelectionChanged="OnFoundPicked"/>
            </TabItem>
          </TabControl>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" Background="Transparent"/>

      <!-- middle: the drawing -->
      <DockPanel Grid.Column="2">
        <!-- where you are: Top > U2 (read-multiplexers); click a level to go back up to it -->
        <!-- a card with pages: the overview, then one tab per drawn page (Page Up / Page Down) -->
        <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel x:Name="PageTabs" Orientation="Horizontal" Spacing="2" Margin="0,6,0,0" IsVisible="False"/>
        </ScrollViewer>
        <StackPanel x:Name="LevelBar" DockPanel.Dock="Top" Orientation="Horizontal" Spacing="2" Margin="0,6,0,0" IsVisible="False"/>
        <!-- several original pages: pick which one the Original view shows -->
        <StackPanel x:Name="PagePickerBar" DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0" IsVisible="False">
          <TextBlock Classes="fluent-text" Text="Page" VerticalAlignment="Center"/>
          <ComboBox x:Name="PagePicker" Classes="fluent-combobox" MinWidth="260" SelectionChanged="OnPagePicked"/>
          <CheckBox x:Name="PageByHand" Content="Pick by hand" VerticalAlignment="Center" Click="OnPageByHand"
                    ToolTip.Tip="Off: the original page follows the drawn page shown. On: the page picked here stays"/>
        </StackPanel>
        <!-- several photos of the side shown (the old and the new board, say): pick which one -->
        <StackPanel x:Name="PhotoPickerBar" DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0" IsVisible="False">
          <TextBlock Classes="fluent-text" Text="Photo" VerticalAlignment="Center"/>
          <ComboBox x:Name="PhotoPicker" Classes="fluent-combobox" MinWidth="320" SelectionChanged="OnPhotoPicked"/>
        </StackPanel>
        <!-- assisted reading on the Original view: the page analyser marks what it finds; a click
             on a find accepts it as a part, wire assist connects a pin at a wire end -->
        <StackPanel x:Name="ReadBar" DockPanel.Dock="Top" Margin="0,6,0,0" Spacing="4" IsVisible="False">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button x:Name="AnalyseButton" Classes="fluent-button" Content="Analyse page" Click="OnAnalysePage"
                    ToolTip.Tip="Find the chips, gates, circled pins and dots on this page (offline). Every find is a guess until accepted"/>
            <CheckBox x:Name="WireAssist" Content="Wire assist" VerticalAlignment="Center" Click="OnWireAssist"
                      ToolTip.Tip="Click a wire end next to a part's box, pick the pin, and it goes on the signal named here"/>
            <TextBlock x:Name="ReadStatus" Classes="fluent-text" VerticalAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel x:Name="FindBar" Orientation="Horizontal" Spacing="6" IsVisible="False">
            <TextBlock x:Name="FindText" Classes="fluent-text" VerticalAlignment="Center"/>
            <TextBlock Classes="fluent-text" Text="Code" VerticalAlignment="Center"/>
            <TextBox x:Name="FindCode" MinWidth="70"/>
            <TextBlock Classes="fluent-text" Text="Type" VerticalAlignment="Center"/>
            <TextBox x:Name="FindType" MinWidth="90"/>
            <TextBlock Classes="fluent-text" Text="or link to" VerticalAlignment="Center"/>
            <ComboBox x:Name="FindLink" Classes="fluent-combobox" MinWidth="150"/>
            <Button x:Name="AcceptFindButton" Classes="fluent-button" Content="Accept" Click="OnAcceptFind"/>
          </StackPanel>
          <StackPanel x:Name="PinBar" Orientation="Horizontal" Spacing="6" IsVisible="False">
            <TextBlock x:Name="PinText" Classes="fluent-text" VerticalAlignment="Center"/>
            <ComboBox x:Name="PinPicker" Classes="fluent-combobox" MinWidth="160"/>
            <TextBlock Classes="fluent-text" Text="onto signal or pin" VerticalAlignment="Center"/>
            <TextBox x:Name="PinTarget" MinWidth="120"/>
            <Button x:Name="ConnectPinButton" Classes="fluent-button" Content="Connect" Click="OnConnectPin"/>
          </StackPanel>
        </StackPanel>
        <Border Classes="panel-border" Margin="0,6" ClipToBounds="True">
          <Grid>
            <c:SchematicCanvas x:Name="Canvas"/>
            <!-- the original page and the board photos, each with its own zoom -->
            <c:ImageView x:Name="OriginalView" IsVisible="False" EmptyText="This sheet has no original page"/>
            <c:ImageView x:Name="FrontView" IsVisible="False" EmptyText="This sheet has no photo of the component side"/>
            <c:ImageView x:Name="BackView" IsVisible="False" EmptyText="This sheet has no photo of the solder side"/>
            <!-- the card overview: its pages (click one to draw it) and the board photos -->
            <ScrollViewer x:Name="OverviewView" IsVisible="False" Background="{DynamicResource FluentBackgroundSecondaryBrush}">
              <StackPanel x:Name="OverviewPanel" Margin="16" Spacing="10"/>
            </ScrollViewer>
          </Grid>
        </Border>
      </DockPanel>
      <GridSplitter Grid.Column="3" Background="Transparent"/>

      <!-- right: what the picked item is -->
      <Border Grid.Column="4" Classes="panel-border" Margin="0,6,6,6" Padding="10">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
              <Button x:Name="DetailsBack" Classes="detail-nav" Click="OnBack" IsEnabled="False" ToolTip.Tip="Back (Alt+Left)" ToolTip.ShowOnDisabled="True"><Path Classes="detail-icon" Data="{StaticResource IconBack}"/></Button>
              <Button x:Name="DetailsForward" Classes="detail-nav" Click="OnForward" IsEnabled="False" ToolTip.Tip="Forward (Alt+Right)" ToolTip.ShowOnDisabled="True"><Path Classes="detail-icon" Data="{StaticResource IconForward}"/></Button>
            </StackPanel>
            <TextBlock Classes="fluent-text-header" Text="Details" VerticalAlignment="Center"/>
          </DockPanel>
          <!-- the traced signal and its pins; clicking a pin centres the drawing on it -->
          <!-- the picked bus and its signals; every change goes through SheetEditor -->
          <!-- the picked switch block, editable in edit mode; built in MainWindow.Board.cs -->
          <StackPanel DockPanel.Dock="Bottom" x:Name="SwitchPanel" IsVisible="False" Margin="0,8,0,0" Spacing="4"/>
          <StackPanel DockPanel.Dock="Bottom" x:Name="BusPanel" IsVisible="False" Margin="0,8,0,0" Spacing="4">
            <TextBlock x:Name="BusTitle" Classes="fluent-text-header"/>
            <ListBox x:Name="BusMemberList" MaxHeight="220"
                     Background="{DynamicResource FluentBackgroundSecondaryBrush}"/>
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="fluent-button" Content="Add" Click="OnBusAdd" Margin="4,0,0,0"/>
              <TextBox x:Name="BusAddBox" Watermark="signal, e.g. BD15_0"/>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button Classes="fluent-button" Content="Remove picked" Click="OnBusRemove"/>
              <Button Classes="fluent-button" Content="Redraw path" Click="OnBusRedraw"/>
              <Button Classes="fluent-button" Content="Delete bus" Click="OnBusDelete"/>
            </StackPanel>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" x:Name="SignalEditPanel" IsVisible="False" Margin="0,8,0,0" Spacing="4">
            <TextBlock x:Name="SignalEditTitle" Classes="fluent-text-header"/>
            <TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="90"
                     Watermark="What the signal does (never invent one: say where it is read)"/>
            <ComboBox x:Name="SourceKindBox" Classes="fluent-combobox" HorizontalAlignment="Stretch"
                      ToolTip.Tip="Where the description comes from"/>
            <TextBox x:Name="SourceDocumentBox" Watermark="Document, e.g. docs/2A50-reading.md"/>
            <TextBox x:Name="SourcePlaceBox" Watermark="Place in it: section or page"/>
            <ComboBox x:Name="SourceConfidenceBox" Classes="fluent-combobox" HorizontalAlignment="Stretch"
                      ToolTip.Tip="How sure the description is"/>
            <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="70" Watermark="Notes"/>
            <Button Classes="fluent-button" Content="Save signal text" Click="OnSignalTextSave"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" x:Name="TracePanel" IsVisible="False" Margin="0,8,0,0">
            <TextBlock x:Name="TraceTitle" Classes="fluent-text-header"/>
            <ListBox x:Name="TraceList" MaxHeight="260" SelectionChanged="OnTracePinPicked"
                     Background="{DynamicResource FluentBackgroundSecondaryBrush}"/>
          </StackPanel>
          <ScrollViewer>
            <c:DetailsPanel x:Name="Details" Margin="0,0,6,0"/>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
