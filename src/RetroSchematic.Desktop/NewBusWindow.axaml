<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RetroSchematic.Desktop.NewBusWindow"
        Icon="avares://RetroSchematic/Assets/RetroSchematic.ico"
        Title="New bus" Width="380" Height="560" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource FluentBackgroundPrimaryBrush}">
  <!-- Asks for a bus name and its signals. Ticking, the filter and the pattern only choose
       signals; the bus itself is made by SheetEditor.CreateBus in the library. Every colour is a
       {DynamicResource} brush from Themes/ThemeManager.cs. -->
  <DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Top" Spacing="6">
      <TextBlock Classes="fluent-text" Text="Bus name"/>
      <TextBox x:Name="NameBox" Classes="fluent-textbox" Watermark="e.g. BD_0"/>
      <TextBlock Classes="fluent-text" Text="Tick signals by pattern (BD*_0, IDATA0-7)"/>
      <DockPanel>
        <Button x:Name="PatternButton" DockPanel.Dock="Right" Classes="fluent-button" Content="Tick" Click="OnPattern" Margin="4,0,0,0"/>
        <TextBox x:Name="PatternBox" Classes="fluent-textbox" Watermark="pattern"/>
      </DockPanel>
      <TextBox x:Name="FilterBox" Classes="fluent-textbox" Watermark="Filter the list" TextChanged="OnFilter"/>
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Classes="dialog-footer">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
        <TextBlock x:Name="CountText" Classes="fluent-text" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <Button x:Name="OkButton" Classes="dialog-primary" Content="OK, then click the path" Click="OnOk"/>
        <Button Classes="dialog-secondary" Content="Cancel" Click="OnCancel"/>
      </StackPanel>
    </Border>
    <TextBlock x:Name="ProblemText" DockPanel.Dock="Bottom" Classes="fluent-text" TextWrapping="Wrap"/>
    <ListBox x:Name="SignalList" Margin="0,6" Background="{DynamicResource FluentBackgroundSecondaryBrush}"/>
  </DockPanel>
</Window>
