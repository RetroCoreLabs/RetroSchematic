<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RetroSchematic.Desktop.SettingsWindow"
        Title="Settings" Width="620" Height="470" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource FluentBackgroundPrimaryBrush}">
  <!-- Every display option in two columns: the defaults for all sheets (kept by the app) and
       this sheet's own values (kept in the sheet file's "display" section, each one may be
       "Use default"). Which value applies is DisplaySettings.Resolve in the library; this window
       only shows the choices. Every colour is a {DynamicResource} brush from
       Themes/ThemeManager.cs. The rows are built in SettingsWindow.axaml.cs. -->
  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Top" Classes="fluent-text" TextWrapping="Wrap" Margin="0,0,0,8"
               Text="A sheet's own value wins over the default. Changing a value for this sheet marks it as changed (save it to keep it); it never changes what is connected."/>
    <Border DockPanel.Dock="Bottom" Classes="dialog-footer">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
        <Button x:Name="OkButton" Classes="dialog-primary" Content="OK" Click="OnOk"/>
        <Button Classes="dialog-secondary" Content="Apply" Click="OnApply"/>
        <Button Classes="dialog-secondary" Content="Cancel" Click="OnCancel"/>
      </StackPanel>
    </Border>
    <ScrollViewer Background="{DynamicResource FluentBackgroundSecondaryBrush}">
      <Grid x:Name="Rows" ColumnDefinitions="200,190,190" Margin="8"/>
    </ScrollViewer>
  </DockPanel>
</Window>
