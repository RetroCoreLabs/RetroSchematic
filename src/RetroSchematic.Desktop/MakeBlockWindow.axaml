<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RetroSchematic.Desktop.MakeBlockWindow"
        Icon="avares://RetroSchematic/Assets/RetroSchematic.ico"
        Title="Make block" Width="460" Height="560" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource FluentBackgroundPrimaryBrush}">
  <!-- Asks only for the block's name and shows the ports it will get, each name editable.
       The ports are planned and the block is made by SheetEditor.PlanBlock / MakeBlock in the
       library. Every colour is a {DynamicResource} brush from Themes/ThemeManager.cs. -->
  <DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Top" Spacing="6">
      <TextBlock Classes="fluent-text" Text="Block name"/>
      <TextBox x:Name="NameBox" Classes="fluent-textbox" Watermark="e.g. address-decode"/>
      <TextBlock x:Name="MembersText" Classes="fluent-text" TextWrapping="Wrap"/>
      <TextBlock Classes="fluent-text" Text="Ports (every signal that crosses the edge; rename as you like)"/>
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Classes="dialog-footer">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
        <Button x:Name="OkButton" Classes="dialog-primary" Content="Make block" Click="OnOk"/>
        <Button Classes="dialog-secondary" Content="Cancel" Click="OnCancel"/>
      </StackPanel>
    </Border>
    <TextBlock x:Name="ProblemText" DockPanel.Dock="Bottom" Classes="fluent-text" TextWrapping="Wrap"/>
    <ScrollViewer Margin="0,6" Background="{DynamicResource FluentBackgroundSecondaryBrush}">
      <StackPanel x:Name="PortList" Spacing="2" Margin="4"/>
    </ScrollViewer>
  </DockPanel>
</Window>
